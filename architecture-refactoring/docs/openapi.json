{
  "openapi": "3.1.0",
  "info": {
    "title": "WareFlow API",
    "description": "Sistema interno di gestione magazzino per NordShip. Espone endpoint REST per magazzini, stock, ordini e spedizioni.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Locale"
    }
  ],
  "tags": [
    { "name": "Warehouses", "description": "Elenco magazzini" },
    { "name": "Stock",      "description": "Disponibilità articoli per SKU" },
    { "name": "Orders",     "description": "Gestione ordini" },
    { "name": "Shipments",  "description": "Elenco spedizioni" }
  ],
  "paths": {
    "/warehouses": {
      "get": {
        "tags": ["Warehouses"],
        "summary": "Elenco magazzini",
        "operationId": "listWarehouses",
        "responses": {
          "200": {
            "description": "Lista dei magazzini registrati",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Warehouse" }
                },
                "example": [
                  { "id": 1, "name": "Milano Nord", "city": "Milano" },
                  { "id": 2, "name": "Bologna Est", "city": "Bologna" },
                  { "id": 3, "name": "Torino Sud",  "city": "Torino" }
                ]
              }
            }
          }
        }
      }
    },
    "/stock/{sku}": {
      "get": {
        "tags": ["Stock"],
        "summary": "Disponibilità attuale di un articolo",
        "operationId": "getStock",
        "parameters": [
          {
            "name": "sku",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "example": "WIDGET-1"
          }
        ],
        "responses": {
          "200": {
            "description": "Quantità disponibile in cache per lo SKU richiesto (0 se sconosciuto)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StockEntry" },
                "example": { "sku": "WIDGET-1", "quantity": 1300 }
              }
            }
          }
        }
      }
    },
    "/stock/{sku}/restock": {
      "post": {
        "tags": ["Stock"],
        "summary": "Aggiunge disponibilità a uno SKU (uso interno / test)",
        "operationId": "restock",
        "parameters": [
          {
            "name": "sku",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "example": "WIDGET-1"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "quantity": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Quantità da aggiungere alla cache. Default 0 se assente."
                  }
                }
              },
              "example": { "quantity": 100 }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Quantità aggiornata dopo il rifornimento",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StockEntry" },
                "example": { "sku": "WIDGET-1", "quantity": 1400 }
              }
            }
          }
        }
      }
    },
    "/orders": {
      "get": {
        "tags": ["Orders"],
        "summary": "Elenco ordini",
        "operationId": "listOrders",
        "responses": {
          "200": {
            "description": "Lista di tutti gli ordini (senza righe di dettaglio)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/OrderSummary" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Orders"],
        "summary": "Crea un nuovo ordine in stato DRAFT",
        "operationId": "createOrder",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateOrderRequest" },
              "example": {
                "customer_name": "Acme Spa",
                "lines": [
                  { "sku": "WIDGET-1", "quantity": 10 },
                  { "sku": "PALLET-BOX", "quantity": 2 }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Ordine creato",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Order" }
              }
            }
          },
          "400": {
            "description": "Payload non valido",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "error": "customer_name is required" }
              }
            }
          }
        }
      }
    },
    "/orders/{order_id}": {
      "get": {
        "tags": ["Orders"],
        "summary": "Dettaglio di un ordine",
        "operationId": "getOrder",
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Ordine con righe di dettaglio",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Order" }
              }
            }
          },
          "404": {
            "description": "Ordine non trovato",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "error": "not found" }
              }
            }
          }
        }
      }
    },
    "/orders/{order_id}/confirm": {
      "post": {
        "tags": ["Orders"],
        "summary": "Conferma l'ordine: scala lo stock, genera la spedizione, notifica il cliente",
        "operationId": "confirmOrder",
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Ordine confermato con spedizione allegata",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OrderWithShipment" }
              }
            }
          },
          "400": {
            "description": "Stock insufficiente o ordine già in uno stato non modificabile",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "error": "not enough stock for WIDGET-1: have 5, need 10" }
              }
            }
          },
          "404": {
            "description": "Ordine non trovato",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "error": "not found" }
              }
            }
          }
        }
      }
    },
    "/orders/{order_id}/cancel": {
      "post": {
        "tags": ["Orders"],
        "summary": "Annulla un ordine in stato DRAFT",
        "operationId": "cancelOrder",
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Ordine annullato",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Order" }
              }
            }
          },
          "400": {
            "description": "Ordine già confermato, impossibile annullare",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "error": "order 1 is already confirmed, cannot cancel" }
              }
            }
          },
          "404": {
            "description": "Ordine non trovato",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "error": "not found" }
              }
            }
          }
        }
      }
    },
    "/shipments": {
      "get": {
        "tags": ["Shipments"],
        "summary": "Elenco spedizioni",
        "operationId": "listShipments",
        "responses": {
          "200": {
            "description": "Lista di tutte le spedizioni",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Shipment" }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Warehouse": {
        "type": "object",
        "properties": {
          "id":   { "type": "integer", "example": 1 },
          "name": { "type": "string",  "example": "Milano Nord" },
          "city": { "type": "string",  "example": "Milano" }
        },
        "required": ["id", "name", "city"]
      },
      "StockEntry": {
        "type": "object",
        "properties": {
          "sku":      { "type": "string",  "example": "WIDGET-1" },
          "quantity": { "type": "integer", "example": 1300 }
        },
        "required": ["sku", "quantity"]
      },
      "OrderLine": {
        "type": "object",
        "properties": {
          "sku":      { "type": "string",  "example": "WIDGET-1" },
          "quantity": { "type": "integer", "minimum": 1, "example": 5 }
        },
        "required": ["sku", "quantity"]
      },
      "CreateOrderRequest": {
        "type": "object",
        "properties": {
          "customer_name": {
            "type": "string",
            "description": "Nome del cliente o azienda",
            "example": "Acme Spa"
          },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/OrderLine" }
          }
        },
        "required": ["customer_name", "lines"]
      },
      "OrderSummary": {
        "type": "object",
        "properties": {
          "id":            { "type": "integer", "example": 1 },
          "customer_name": { "type": "string",  "example": "Acme Spa" },
          "status": {
            "type": "string",
            "enum": ["DRAFT", "CONFIRMED", "CANCELLED"],
            "example": "DRAFT"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-05 10:00:00"
          }
        },
        "required": ["id", "customer_name", "status", "created_at"]
      },
      "Order": {
        "allOf": [
          { "$ref": "#/components/schemas/OrderSummary" },
          {
            "type": "object",
            "properties": {
              "lines": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/OrderLine" }
              }
            },
            "required": ["lines"]
          }
        ]
      },
      "Shipment": {
        "type": "object",
        "properties": {
          "id":            { "type": "integer", "example": 1 },
          "order_id":      { "type": "integer", "example": 1 },
          "warehouse_id":  { "type": "integer", "example": 1 },
          "tracking_code": { "type": "string",  "example": "WF-A1B2C3D4" },
          "status": {
            "type": "string",
            "enum": ["PENDING"],
            "example": "PENDING"
          }
        },
        "required": ["id", "order_id", "warehouse_id", "tracking_code", "status"]
      },
      "OrderWithShipment": {
        "allOf": [
          { "$ref": "#/components/schemas/Order" },
          {
            "type": "object",
            "properties": {
              "shipment": { "$ref": "#/components/schemas/Shipment" }
            },
            "required": ["shipment"]
          }
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "example": "not found" }
        },
        "required": ["error"]
      }
    }
  }
}
